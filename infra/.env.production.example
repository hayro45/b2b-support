# Copy to the repository root as .env.production (never commit that file).
# Generate APP_JWT_SECRET with: openssl rand -base64 48
# Leave placeholders empty until real secrets are supplied; Compose will reject them.
POSTGRES_DB=support_db
POSTGRES_USER=support_user
POSTGRES_PASSWORD=
APP_JWT_SECRET=
APP_CORS_ALLOWED_ORIGINS=https://support.hayrettindal.com
APP_JWT_EXPIRATION_SECONDS=3600
VITE_API_BASE_URL=/api
